SELF_VERSION <- 10              // integer version of the AI, needs to be increased with each release
SELF_MINLOADVERSION <- 10       // minimum integer version of AI that can load this version, increased when major version is increased
SELF_MAJORVERSION <- 1          // main version of the AI, releases with same major version should be saveload compatible
SELF_MINORVERSION <- 0          // minor version of the AI, incremental subreleases of the major version, saveload compatible
SELF_DATE <- "2026-01-30"       // release date [YYYY-MM-DD]
